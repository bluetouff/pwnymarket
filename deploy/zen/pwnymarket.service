[Unit]
Description=PwnyMarket privacy-preserving vote service
After=local-fs.target

[Service]
Type=simple
User=pwnymarket
Group=www-data
WorkingDirectory=/var/www/html/pwnymarket/current/zen
Environment=NODE_ENV=production
Environment=PWNYMARKET_PUBLIC_ORIGIN=https://pwnymarket.l0g.fr
Environment=PWNYMARKET_SOCKET=/run/pwnymarket/pwnymarket.sock
Environment=PWNYMARKET_LEDGER=/var/lib/pwnymarket/votes.ndjson
EnvironmentFile=/etc/pwnymarket.env
ExecStartPre=/usr/bin/node /var/www/html/pwnymarket/current/deploy/zen/check-runtime.mjs
ExecStart=/usr/bin/node /var/www/html/pwnymarket/current/zen/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStartSec=15s
TimeoutStopSec=10s
RuntimeDirectory=pwnymarket
RuntimeDirectoryMode=0750
StateDirectory=pwnymarket
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
